@using Microsoft.AspNetCore.Identity
@using CRMProject.Data.Entities
@inject UserManager<AppUser> UserManager

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var user = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var userDisplayName = user?.AdıSoyadı ?? User.Identity?.Name ?? "Kullanıcı";
    var userRole = User.IsInRole("Admin") ? "Admin" : "Kullanıcı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")ESBİ CRM</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="app-container">
            <!-- Mobile Backdrop -->
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <!-- Sidebar -->
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-header">
                    <div class="sidebar-brand-icon">
                        <i class="fas fa-cubes"></i>
                    </div>
                    <div>
                        <h1 class="sidebar-brand-title">ESBİ CRM</h1>
                        <p class="sidebar-brand-sub">Müşteri & Stok Yönetimi</p>
                    </div>
                </div>

                <div class="sidebar-nav">
                    <div class="sidebar-section-title">Ana Menü</div>

                    <a asp-controller="Dashboard" asp-action="Index"
                       class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">
                        <i class="fas fa-home"></i>
                        <span>Ana Panel</span>
                    </a>

                    <a asp-controller="Cari" asp-action="Index"
                       class="sidebar-link @(currentController == "Cari" ? "active" : "")">
                        <i class="fas fa-users"></i>
                        <span>Cari Yönetimi</span>
                    </a>

                    <a asp-controller="Malzeme" asp-action="Index"
                       class="sidebar-link @(currentController == "Malzeme" ? "active" : "")">
                        <i class="fas fa-boxes-stacked"></i>
                        <span>Malzeme Yönetimi</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="sidebar-section-title mt-3">Sistem Yönetimi</div>

                        <a asp-controller="Kullanici" asp-action="Index"
                           class="sidebar-link @(currentController == "Kullanici" ? "active" : "")">
                            <i class="fas fa-user-gear"></i>
                            <span>Kullanıcı Yönetimi</span>
                        </a>

                        <a asp-controller="Ayar" asp-action="Index"
                           class="sidebar-link @(currentController == "Ayar" ? "active" : "")">
                            <i class="fas fa-sliders"></i>
                            <span>Sistem Ayarları</span>
                        </a>
                    }
                </div>

                <div class="sidebar-footer">
                    <div class="user-card">
                        <div class="user-avatar">
                            @(userDisplayName.Length > 0 ? userDisplayName.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="user-info">
                            <p class="user-name" title="@userDisplayName">@userDisplayName</p>
                            <span class="user-role-badge">@userRole</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Çıkış Yap">
                                <i class="fas fa-arrow-right-from-bracket"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Main Panel -->
            <div class="app-main">
                <!-- Topbar -->
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button type="button" class="topbar-toggle" id="sidebarToggle" aria-label="Menüyü Aç">
                            <i class="fas fa-bars"></i>
                        </button>
                        <div>
                            <h2 class="page-title">@(ViewData["Title"] ?? "CRM Paneli")</h2>
                        </div>
                    </div>
                    <div class="topbar-right">
                        <span class="d-none d-md-inline text-muted small me-2">
                            <i class="far fa-calendar-alt me-1"></i>@DateTime.Now.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))
                        </span>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-circle-user text-primary"></i>
                                <span class="d-none d-sm-inline">@userDisplayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <h6 class="dropdown-header">@User.Identity?.Name</h6>
                                </li>
                                <li><span class="dropdown-item-text small text-muted"><i class="fas fa-shield me-1"></i>Rol: @userRole</span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="fas fa-sign-out-alt me-1"></i>Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content -->
                <main class="app-content">
                    @if (TempData["Başarı"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Başarı"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }
                    @if (TempData["Hata"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Hata"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="app-footer">
                    <div>
                        <strong>ESBİ Bilişim ve Telekomünikasyon</strong> &copy; 2025 - Stajyer Projesi
                    </div>
                    <div class="text-muted">
                        <span>ASP.NET Core MVC 8.0 • EF Core</span>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="container py-4">
            @if (TempData["Başarı"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Başarı"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            }
            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Hata"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                </div>
            }
            @RenderBody()
        </div>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar Toggle for Mobile
        const sidebar = document.getElementById('appSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggle');

        if (toggleBtn && sidebar && backdrop) {
            toggleBtn.addEventListener('click', function () {
                sidebar.classList.toggle('show');
                backdrop.classList.toggle('show');
            });

            backdrop.addEventListener('click', function () {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
