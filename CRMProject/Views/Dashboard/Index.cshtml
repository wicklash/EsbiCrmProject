@model CRMProject.Models.DashboardViewModel
@{
    ViewData["Title"] = "Ana Panel";
}

<!-- Quick Actions Banner -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Hoş Geldiniz!</h3>
        <p class="text-muted mb-0 small">Sisteme kayıtlı cariler, stok durumu ve özet istatistikler aşağıda listelenmiştir.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Cari" asp-action="Ekle" class="btn btn-outline-primary">
            <i class="fas fa-user-plus me-1"></i>Yeni Cari Ekle
        </a>
        <a asp-controller="Malzeme" asp-action="Ekle" class="btn btn-primary">
            <i class="fas fa-box-open me-1"></i>Yeni Malzeme Ekle
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-blue">
            <div>
                <div class="stat-label">Toplam Cari</div>
                <h4 class="stat-value">@Model.ToplamCari</h4>
                <div class="stat-desc">Aktif müşteri & tedarikçiler</div>
            </div>
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-green">
            <div>
                <div class="stat-label">Toplam Malzeme</div>
                <h4 class="stat-value">@Model.ToplamMalzeme</h4>
                <div class="stat-desc">Tanımlı ürün & stok kartı</div>
            </div>
            <div class="stat-icon">
                <i class="fas fa-boxes-stacked"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-amber">
            <div>
                <div class="stat-label">Kritik Stok</div>
                <h4 class="stat-value text-danger">@Model.KritikStoklar.Count</h4>
                <div class="stat-desc">Eşik değerin altındaki ürünler</div>
            </div>
            <div class="stat-icon">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="stat-card stat-purple">
            <div>
                <div class="stat-label">Sistem Durumu</div>
                <h4 class="stat-value text-success">Aktif</h4>
                <div class="stat-desc">SQL Server bağlı</div>
            </div>
            <div class="stat-icon">
                <i class="fas fa-server"></i>
            </div>
        </div>
    </div>
</div>

<!-- Tables Grid -->
<div class="row g-4">
    <!-- Son Eklenen Cariler -->
    <div class="col-lg-6">
        <div class="crm-card h-100">
            <div class="crm-card-header">
                <h5 class="crm-card-title">
                    <i class="fas fa-user-clock text-primary"></i>Son Eklenen Cariler
                </h5>
                <a asp-controller="Cari" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
                    Tümünü Gör <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.SonCariler.Any())
                {
                    <div class="table-responsive">
                        <table class="crm-table">
                            <thead>
                                <tr>
                                    <th>Cari Kodu</th>
                                    <th>Ünvan</th>
                                    <th>Cari Tipi</th>
                                    <th>İl</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SonCariler)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border font-monospace">@item.CariKodu</span>
                                        </td>
                                        <td class="fw-semibold">@item.Ünvan</td>
                                        <td>
                                            @if (item.CariTipi == "Müşteri")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Müşteri</span>
                                            }
                                            else if (item.CariTipi == "Tedarikçi")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle">Tedarikçi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">@item.CariTipi</span>
                                            }
                                        </td>
                                        <td class="text-muted">@(item.İl ?? "-")</td>
                                        <td class="text-end">
                                            <a asp-controller="Cari" asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="Düzenle">
                                                <i class="fas fa-pencil text-primary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fas fa-folder-open fa-2x mb-2 text-secondary"></i>
                        <p class="mb-0">Henüz kayıtlı cari bulunmamaktadır.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Kritik Stok Uyarıları -->
    <div class="col-lg-6">
        <div class="crm-card h-100">
            <div class="crm-card-header">
                <h5 class="crm-card-title text-danger">
                    <i class="fas fa-triangle-exclamation"></i>Kritik Stok Uyarısı (@Model.KritikStoklar.Count)
                </h5>
                <a asp-controller="Malzeme" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">
                    Tümünü Gör <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.KritikStoklar.Any())
                {
                    <div class="table-responsive">
                        <table class="crm-table">
                            <thead>
                                <tr>
                                    <th>Malzeme</th>
                                    <th>Kategori</th>
                                    <th>Mevcut</th>
                                    <th>Kritik Eşik</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.KritikStoklar)
                                {
                                    <tr class="row-critical">
                                        <td>
                                            <div class="fw-bold text-danger">@item.MalzemeAdı</div>
                                            <small class="text-muted font-monospace">@item.MalzemeKodu</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary">@(item.Kategori ?? "Genel")</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger">@item.StokMiktarı.ToString("N0") @item.Birim</span>
                                        </td>
                                        <td class="text-muted">@item.KritikStok.ToString("N0") @item.Birim</td>
                                        <td class="text-end">
                                            <a asp-controller="Malzeme" asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-light border" title="Düzenle">
                                                <i class="fas fa-pencil text-primary"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-success">
                        <i class="fas fa-circle-check fa-2x mb-2"></i>
                        <p class="mb-0">Tüm malzeme stok seviyeleri yeterli durumda!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
